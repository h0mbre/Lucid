+static inline void update_coverage_map(uint32_t hash, uint64_t src, uint64_t dst) {
+    uint8_t *map_addr = g_lucid_ctx->coverage_map_addr;
+
+    // Record the edge endpoints only when this input first occupies a slot
+    // that no previous input has occupied.
+    if (map_addr[hash] == 0 && g_lucid_ctx->coverage_history_map_addr[hash] == 0) {
+        record_edge_pcs(src, dst);
+    }
+
+    map_addr[hash]++;
+    if (map_addr[hash] == 0) {
+        map_addr[hash] = 1;
+    }
+}
