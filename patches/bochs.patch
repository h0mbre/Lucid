+    // Each guest entry must describe bytes from exactly one physical page.
+    if (!segment_len || (segment_addr & 0xfff) + segment_len > 0x1000) {
+      delete [] spans;
+      BX_PANIC(("Lucid input segment crosses a guest physical page"));
+    }
+
+    // Check the sum before adding so a corrupt snapshot cannot wrap it.
+    if (total_size > layout_len ||
+        segment_len > layout_len - total_size) {
+      delete [] spans;
+      BX_PANIC(("Lucid input segments exceed the advertised capacity"));
+    }
+
+    bx_hostpageaddr_t span_host = getHostMemAddr(segment_addr, BX_WRITE);
+
+    if (!span_host) {
+      delete [] spans;
+      BX_PANIC(("Lucid input page has no writable host mapping"));
+    }
+
+    spans[index].addr = (Bit8u *) span_host;
+    spans[index].len = segment_len;
+    total_size += segment_len;
+  }
