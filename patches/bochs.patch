@@ -235,6 +236,71 @@
   BX_WRITE_16BIT_REG(i->src(), op1_16);
   BX_WRITE_16BIT_REG(i->dst(), op2_16);
 
+#if BX_SNAPSHOT
+  // Check for take snapshot instruction `xchg dx, dx`
+  if ((i->src() == i->dst()) && (i->src() == 2)) {
+    BX_COMMIT_INSTRUCTION(i);
+    if (BX_CPU_THIS_PTR async_event)
+      return;
+    ++i;
+    char save_dir[] = "/tmp/lucid_snapshot";
+    mkdir(save_dir, 0777);
+    printf("Saving Lucid snapshot to '%s'...\n", save_dir);
+    if (SIM->save_state(save_dir)) {
+      printf("Successfully saved snapshot\n");
+      sleep(2);
+      exit(0);
+    }
+    else {
+      printf("Failed to save snapshot\n");
+    }
+    BX_EXECUTE_INSTRUCTION(i);
+  }
+#endif
+
+#if BX_LUCID
+  // Check for special NOP
+  if (i->src() == i->dst()) {
+    unsigned operation = 5;
+
+    switch (i->src()) {
+      // These are Lucid lifecycle handlers
+      case 3: // Perform a snapshot reset
+        if (g_lucid_ctx) {
+          BX_INSTR_EDGE_PC_FLUSH();
+          lucid_postfuzz_hook();
+        }
+        break;
+
+      case 4: // Handle a crash
+        if (g_lucid_ctx) {
+          g_lucid_ctx->crash = 1;
+          BX_INSTR_EDGE_PC_FLUSH();
+          lucid_postfuzz_hook();
+        }
+        break;
+
+      // These are IJON tag handlers
+      case 0: operation = 0; break; // SET
+      case 1: operation = 1; break; // MAX
+      case 5: operation = 2; break; // INC
+      case 6: operation = 3; break; // STATE
+      case 7: operation = 4; break; // EVENT
+      default: break;
+    }
+
+    // Report an IJON operation using R8 as the tag and R9 as the value
+    if (operation < 5 && g_lucid_ctx) {
+      g_lucid_report_ijon(
+          g_lucid_ctx,
+          operation,
+          (uint64_t) BX_READ_64BIT_REG(BX_64BIT_REG_R8),
+          (uint64_t) BX_READ_64BIT_REG(BX_64BIT_REG_R9),
+          (size_t) RIP);
+    }
+  }
+#endif
+
   BX_NEXT_INSTR(i);
 }
 
