+static inline void record_edge_pcs(uint64_t src, uint64_t dst) {
+    // Every record is a pair, so a full buffer always ends on a pair boundary
+    edge_pc_buffer[edge_pc_buffer_index++] = src;
+    edge_pc_buffer[edge_pc_buffer_index++] = dst;
+    if (edge_pc_buffer_index == EDGE_PC_BUFFER_CAPACITY) {
+        bx_instr_edge_pc_flush();
+    }
+}
