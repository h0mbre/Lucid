 #if BX_INSTRUMENTATION
 
@@ -38,8 +39,106 @@
 void bx_instr_debug_promt() {}
 void bx_instr_debug_cmd(const char *cmd) {}
 
+static inline uint32_t hash_coverage(uint64_t src, uint64_t dst) {
+    // Combine the ordered edge endpoints into a single 64-bit value
+    uint64_t hash = src;
+    hash ^= dst + 0x9e3779b97f4a7c15ULL + (hash << 6) + (hash >> 2);
+
+    // Use the SplitMix64 finalizer so every address bit influences the index
+    hash ^= hash >> 30;
+    hash *= 0xbf58476d1ce4e5b9ULL;
+    hash ^= hash >> 27;
+    hash *= 0x94d049bb133111ebULL;
+    hash ^= hash >> 31;
+
+    // Truncate the mixed value to an index in the power-of-two coverage map
+    return (uint32_t)(hash & (g_lucid_ctx->coverage_map_size - 1));
+}
+
+static inline uint64_t dbj2_hash_trace(uint64_t src, uint64_t dst) {
+    uint64_t hash = src;
+    if (hash == 0) {
+        hash = 5381;
+    }
+
+    hash = ((hash << 5) + hash) + (uint32_t)(dst);
+
+    return hash;
+}
+
+#if BX_LUCID
+#define EDGE_PC_BUFFER_CAPACITY (1U << 16)
+
+static uint64_t edge_pc_buffer[EDGE_PC_BUFFER_CAPACITY];
+static size_t edge_pc_buffer_index = 0;
+
+void bx_instr_edge_pc_flush(void) {
+    if (edge_pc_buffer_index == 0) {
+        return;
+    }
+
+    g_lucid_report_edge_pcs(g_lucid_ctx, edge_pc_buffer, edge_pc_buffer_index);
+    edge_pc_buffer_index = 0;
