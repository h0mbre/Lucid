+  size_t total_size = 0;
+
+  // Resolve each saved physical span to the writable host pointer belonging to
+  // this Bochs process.  Lucid will copy the resulting vector immediately.
+  for (size_t index = 0; index < segment_count; index++) {
+    bx_phy_address segment_addr = (bx_phy_address)
+        bx_pc_system.lucid_input_spans[index].phys_addr;
+    size_t segment_len = (size_t)
+        bx_pc_system.lucid_input_spans[index].len;
